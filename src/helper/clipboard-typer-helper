#!/usr/bin/env python3
"""Cancelable X11 keyboard typing helper. Clipboard text is never logged."""

from __future__ import annotations

import argparse
import os
import signal
import subprocess
import sys
import threading


STOPPED = threading.Event()
CHILD: subprocess.Popen[bytes] | None = None


def stop(_signum: int, _frame: object) -> None:
    """Stop the active xdotool process group without exposing its input."""
    STOPPED.set()
    child = CHILD
    if child is not None and child.poll() is None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Ввод UTF-8 через xdotool")
    parser.add_argument("--start-delay-ms", type=int, default=2000)
    parser.add_argument("--key-delay-ms", type=int, default=50)
    args = parser.parse_args()
    if not 0 <= args.start_delay_ms <= 15000:
        parser.error("--start-delay-ms должен быть от 0 до 15000")
    if not 0 <= args.key_delay_ms <= 1000:
        parser.error("--key-delay-ms должен быть от 0 до 1000")
    return args


def main() -> int:
    global CHILD
    args = parse_args()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    if os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland":
        print("Набор недоступен: xdotool не поддерживает сеанс Wayland.", file=sys.stderr)
        return 3
    if not os.environ.get("DISPLAY"):
        print("Набор недоступен: переменная DISPLAY не задана.", file=sys.stderr)
        return 3

    data = sys.stdin.buffer.read()
    try:
        data.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        print("Получены некорректные данные UTF-8.", file=sys.stderr)
        return 2

    if not data:
        return 0
    if STOPPED.wait(args.start_delay_ms / 1000):
        return 130

    command = [
        "xdotool", "type", "--clearmodifiers",
        "--delay", str(args.key_delay_ms), "--file", "-",
    ]
    try:
        CHILD = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except FileNotFoundError:
        print("Не найден xdotool. Установите системный пакет xdotool.", file=sys.stderr)
        return 4

    try:
        _stdout, stderr = CHILD.communicate(input=data)
    except BrokenPipeError:
        stderr = CHILD.stderr.read() if CHILD.stderr else b""
    code = CHILD.returncode
    CHILD = None
    if STOPPED.is_set():
        return 130
    if code != 0:
        message = stderr.decode("utf-8", errors="replace").strip()
        print(message or "xdotool завершился с ошибкой.", file=sys.stderr)
        return code or 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

